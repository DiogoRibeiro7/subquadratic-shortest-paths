# pkg-config file for libsssp
# Allows projects using pkg-config to find and use libsssp
#
# Usage:
#   pkg-config --cflags --libs libsssp

prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libsssp
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@

Requires:
Requires.private:
Conflicts:
Cflags: -I${includedir}
Libs: -L${libdir} -lsssp
Libs.private: -lm
